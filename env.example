# тФАтФАтФА Majburiy тФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФА
BOT_TOKEN=

# Supabase / PostgreSQL. Misollar:
#   postgresql://postgres.xxx:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
#   postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
# Parolda @ # : $ bo'lsa URL-encode qiling yoki SUPABASE_DB_* alohida o'zgaruvchilarni ishlating.
DATABASE_URL=

# DATABASE_URL o'rniga (ixtiyoriy, maxsus parol uchun):
# SUPABASE_DB_HOST=db.xxxxx.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=postgres

# Super-admin Telegram ID'lari (faqat env, vergul bilan).
# Oddiy admin/viewer bot orqali qo'lda qo'shiladi — bu ro'yxatdan avto-ko'chirilmaydi.
ADMIN_IDS=

# Yangi QR kodlar shu domen bilan yaratiladi. Oxirida "/" BO'LMASIN.
BASE_URL=https://promo-bot-ucad.onrender.com

# тФАтФАтФА Tarmoq (odatda o'zgartirish shart emas) тФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФА
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Render / reverse proxy orqasida тАФ true
TRUST_X_FORWARDED_FOR=true

# тФАтФАтФА Tezlik cheklovi (rate limit) тФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФА
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60

# Dedup: bir link ichida bir cookie — faqat birinchi promo QR hisoblanadi (IP+UA yo'q).
# track_visitors saqlash (kun). 0 = avtomatik tozalash o'chirilgan. clicks saqlanadi.
TRACK_VISITORS_RETENTION_DAYS=90
TRACK_VISITORS_CLEANUP_INTERVAL_HOURS=24

# Render deploy: polling oldidan kutish (eski instance SIGTERM olishi uchun)
# POLLING_START_DELAY_SEC=5

# тФАтФАтФА QR ko'rinishi тАФ ixtiyoriy тФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФАтФА
# QR_FOREGROUND_COLOR=#7B4FE0
# QR_BACKGROUND_COLOR=#FFFFFF
# QR_GRADIENT_CENTER=#3B82F6
# QR_GRADIENT_EDGE=
# QR_LOGO_PATH=
# QR_LOGO_RATIO=0.22
# QR_BOX_SIZE=12
# QR_BORDER=2

# TELEGRAM_HTTP_TIMEOUT=120
